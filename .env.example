# Anthropic API key — used by the content agent to draft posts.
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# GitHub token used to open pull requests against the blog repos.
# Needs `repo` scope (or fine-grained: Contents + Pull requests: Read & write)
# on scansafeguard-blog and warnerware.
GITHUB_TOKEN=ghp_...

# --- Hero-image generation (M4: `friday image`) --------------------------
# Which provider renders post hero images. One of: openai | google | xai.
# Only the API key for the SELECTED provider is required.
IMAGE_PROVIDER=openai

# OpenAI gpt-image-1 — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Google Imagen (Gemini API) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=...
# xAI Grok image — https://console.x.ai
XAI_API_KEY=xai-...
