# Anthropic API key — used by the content agent to draft posts.
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# GitHub token used to open pull requests against the blog repos.
# Needs `repo` scope (or fine-grained: Contents + Pull requests: Read & write)
# on scansafeguard-blog and warnerware.
GITHUB_TOKEN=ghp_...
